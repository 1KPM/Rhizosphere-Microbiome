# 加载系统发育树
tree_file <- read.tree('./data/tree_metadata_merge_info_final_align_tree.nwk')
# 修剪树只保留有效ASV
retain_labels <- rownames(bac_order_coevoled_asv_total)
drop_list <- setdiff(tree_file$tip.label, retain_labels)
fin_tree <- drop.tip(tree_file, drop_list)
# 准备树元数据
metadata_tree <- read.csv('./data/tree_metadata_merge_info.csv') %>%
filter(TreeID %in% fin_tree$tip.label) %>%
mutate(
Order = if_else(Order %in% plant_colors$Order, Order, "Others"),
Order = factor(Order, levels = plant_colors$Order)
)
# 确保丰度表与树tip顺序一致
fin_table <- bac_order_coevoled_asv_total[fin_tree$tip.label, ] %>%
rownames_to_column("label")
# 4. 系统发育树可视化 -------------------------------------------------------
# 按植物目进行分组
plant_groupInfo <- split(
metadata_tree$TreeID,
metadata_tree$Order
)
# 创建分组树对象
plant_tree_grouped <- groupOTU(
fin_tree,
plant_groupInfo,
group_name = "Lineage"
)
# 绘制基础系统发育树
plant_tree <- ggtree(
plant_tree_grouped,
aes(color = Lineage),
size = 0.8,
layout = 'fan',
open.angle = 180,
branch.length = "none",
right = TRUE,
linewidth = 0.1
) +
scale_color_manual(
values = setNames(plant_colors$Color2, plant_colors$Order),
breaks = plant_colors$Order
) +
new_scale_color()
# 5. 添加ASV丰度条形图 -----------------------------------------------------
# 初始化最终图形对象
plant_final_plot <- plant_tree
# 动态添加每个植物目的丰度条形图
for (i in seq_along(plant_colors$Order)) {
col_name <- paste0(plant_colors$Order[i], "_coevolved_ASV")
col_color <- plant_colors$Color2[i]
plant_final_plot <- plant_final_plot +
geom_fruit(
data = fin_table,
geom = geom_col,  # 使用geom_col替代geom_bar
mapping = aes_string(y = "label", x = col_name),
position = position_identity(),  # 明确指定位置参数
width = 0.6,     # 减小条形宽度
pwidth = 0.08,   # 减小环形宽度
fill = col_color,
orientation = "y",
show.legend = FALSE
)
}
# 加载植物分类颜色映射
plant_colors <- read.csv("./data/Tree_top10Order_color.csv")
# 加载核心细菌ASV的共生分析结果
bac_lambda_rf_asv <- read.csv(
file = "./data/bac_core_asv_qa_log_lambda_indicators.csv",
row.names = 1
)
# 加载核心ASV的平均相对丰度
bac_asv_mean <- read.csv(
'./data/bac_core_feature_table_relative_mean.csv',
header = TRUE,
row.names = 1,
check.names = FALSE
) %>%
t() %>%
as.data.frame() %>%
rownames_to_column("FeatureID")
# 2. 数据处理 ---------------------------------------------------------------
# 筛选与植物目显著共生的ASV
bac_order_coevoled_asv <- bac_lambda_rf_asv %>%
filter(!is.na(Tree_Order) & P < 0.05) %>%
select(FeatureID, Tree_Order) %>%
inner_join(bac_asv_mean, by = "FeatureID")
# 按植物目聚合丰度
bac_order_coevoled_asv <- bac_lambda_rf_asv[!is.na(bac_lambda_rf_asv$Tree_Order) & bac_lambda_rf_asv$P < 0.05,]
bac_order_coevoled_asv <- merge.data.frame(bac_order_coevoled_asv[,c("FeatureID", "Tree_Order")], bac_asv_mean, by = "FeatureID")
bac_order_coevoled_asv_total <- aggregate(bac_order_coevoled_asv[,-c(1:2)], by = list(bac_order_coevoled_asv$Tree_Order), FUN = sum)
bac_order_coevoled_asv_total <- bac_order_coevoled_asv_total %>% column_to_rownames("Group.1")
bac_order_coevoled_asv_total <- as.data.frame(t(bac_order_coevoled_asv_total))
bac_order_coevoled_asv_total <- bac_order_coevoled_asv_total[, plant_colors$Order]
names(bac_order_coevoled_asv_total) <- paste(names(bac_order_coevoled_asv_total), "_coevolved_ASV", sep = "")
View(bac_order_coevoled_asv_total)
names(bac_order_coevoled_asv_total) <- paste0(
names(bac_order_coevoled_asv_total), "_coevolved_ASV"
)
View(bac_order_coevoled_asv_total)
# 加载必要的包
library(dplyr)
library(tibble)
library(ggtree)
library(ggplot2)
library(ggtreeExtra)
library(RColorBrewer)
library(ggnewscale)
library(reshape2)
library(scales)
library(tidyr)
library(ape)
# 设置工作目录（使用RStudio API）
if (interactive()) {
pwd <- dirname(rstudioapi::getSourceEditorContext()$path)
setwd(pwd)
}
# 1. 数据准备 ---------------------------------------------------------------
# 加载植物分类颜色映射
plant_colors <- read.csv("./data/Tree_top10Order_color.csv")
# 加载核心细菌ASV的共生分析结果
bac_lambda_rf_asv <- read.csv(
file = "./data/bac_core_asv_qa_log_lambda_indicators.csv",
row.names = 1
)
# 加载核心ASV的平均相对丰度
bac_asv_mean <- read.csv(
'./data/bac_core_feature_table_relative_mean.csv',
header = TRUE,
row.names = 1,
check.names = FALSE
) %>%
t() %>%
as.data.frame() %>%
rownames_to_column("FeatureID")
# 2. 数据处理 ---------------------------------------------------------------
# 筛选与植物目显著共生的ASV
bac_order_coevoled_asv <- bac_lambda_rf_asv %>%
filter(!is.na(Tree_Order) & P < 0.05) %>%
select(FeatureID, Tree_Order) %>%
inner_join(bac_asv_mean, by = "FeatureID")
# 按植物目聚合丰度
bac_order_coevoled_asv <- bac_lambda_rf_asv[!is.na(bac_lambda_rf_asv$Tree_Order) & bac_lambda_rf_asv$P < 0.05,]
bac_order_coevoled_asv <- merge.data.frame(bac_order_coevoled_asv[,c("FeatureID", "Tree_Order")], bac_asv_mean, by = "FeatureID")
bac_order_coevoled_asv_total <- aggregate(bac_order_coevoled_asv[,-c(1:2)], by = list(bac_order_coevoled_asv$Tree_Order), FUN = sum)
bac_order_coevoled_asv_total <- bac_order_coevoled_asv_total %>% column_to_rownames("Group.1")
bac_order_coevoled_asv_total <- as.data.frame(t(bac_order_coevoled_asv_total))
bac_order_coevoled_asv_total <- bac_order_coevoled_asv_total[, plant_colors$Order]
names(bac_order_coevoled_asv_total) <- paste(names(bac_order_coevoled_asv_total), "_coevolved_ASV", sep = "")
# 3. 系统发育树准备 ---------------------------------------------------------
# 加载系统发育树
tree_file <- read.tree('./data/tree_metadata_merge_info_final_align_tree.nwk')
# 修剪树只保留有效ASV
retain_labels <- rownames(bac_order_coevoled_asv_total)
drop_list <- setdiff(tree_file$tip.label, retain_labels)
fin_tree <- drop.tip(tree_file, drop_list)
# 准备树元数据
metadata_tree <- read.csv('./data/tree_metadata_merge_info.csv') %>%
filter(TreeID %in% fin_tree$tip.label) %>%
mutate(
Order = if_else(Order %in% plant_colors$Order, Order, "Others"),
Order = factor(Order, levels = plant_colors$Order)
)
# 确保丰度表与树tip顺序一致
fin_table <- bac_order_coevoled_asv_total[fin_tree$tip.label, ] %>%
rownames_to_column("label")
# 4. 系统发育树可视化 -------------------------------------------------------
# 按植物目进行分组
plant_groupInfo <- split(
metadata_tree$TreeID,
metadata_tree$Order
)
# 创建分组树对象
plant_tree_grouped <- groupOTU(
fin_tree,
plant_groupInfo,
group_name = "Lineage"
)
# 绘制基础系统发育树
plant_tree <- ggtree(
plant_tree_grouped,
aes(color = Lineage),
size = 0.8,
layout = 'fan',
open.angle = 180,
branch.length = "none",
right = TRUE,
linewidth = 0.1
) +
scale_color_manual(
values = setNames(plant_colors$Color2, plant_colors$Order),
breaks = plant_colors$Order
) +
new_scale_color()
# 5. 添加ASV丰度条形图 -----------------------------------------------------
# 初始化最终图形对象
plant_final_plot <- plant_tree
# 动态添加每个植物目的丰度条形图
for (i in seq_along(plant_colors$Order)) {
col_name <- paste0(plant_colors$Order[i], "_coevolved_ASV")
col_color <- plant_colors$Color2[i]
plant_final_plot <- plant_final_plot +
geom_fruit(
data = fin_table,
geom = geom_col,  # 使用geom_col替代geom_bar
mapping = aes_string(y = "label", x = col_name),
position = position_identity(),  # 明确指定位置参数
width = 0.6,     # 减小条形宽度
pwidth = 0.08,   # 减小环形宽度
fill = col_color,
orientation = "y",
show.legend = FALSE
)
}
plant_final_plot
# 6. 结果导出 ---------------------------------------------------------------
# 创建结果目录（如果不存在）
if (!dir.exists("./result")) {
dir.create("./result")
}
# 保存完整图形（带图例）
ggsave(
plot = plant_final_plot,
filename = "./result/Figure5D_plant_orders_coevolved_bacterial_asv.pdf",
width = 12,
height = 12,
dpi = 900,
bg = "white"
)
# 保存无图例版本
final_plot_nolegend <- plant_final_plot + theme(legend.position = "none")
ggsave(
plot = final_plot_nolegend,
filename = "./result/Figure5D_plant_orders_coevolved_bacterial_asv_nolegend.pdf",
width = 115/2,
height = 115/2,
units = "mm",
dpi = 900,
bg = "white"
)
# 保存TIFF格式
ggsave(
plot = final_plot_nolegend,
filename = "./result/Figure5D_plant_orders_coevolved_bacterial_asv_nolegend.tiff",
width = 115/2,
height = 115/2,
units = "mm",
dpi = 900,
bg = "white"
)
# 保存JPG格式
ggsave(
plot = final_plot_nolegend,
filename = "./result/Figure5D_plant_orders_coevolved_bacterial_asv_nolegend.jpg",
width = 115/2,
height = 115/2,
units = "mm",
dpi = 900,
bg = "white"
)
# 脚本执行完成提示
message("可视化完成！结果已保存到./result目录")
bac_order_coevoled_asv_total <- bac_lambda_rf_asv %>%
# 筛选显著关联的ASV
filter(!is.na(Tree_Order) & P < 0.05) %>%
# 选择需要的列
select(FeatureID, Tree_Order) %>%
# 合并丰度数据
inner_join(bac_asv_mean, by = "FeatureID") %>%
# 按植物目分组求和
group_by(Tree_Order) %>%
summarise(across(-FeatureID, sum), .groups = "drop") %>%
# 设置行名并转置
column_to_rownames("Tree_Order") %>%
t() %>%
as.data.frame() %>%
# 按指定顺序选择列
select(all_of(plant_colors$Order)) %>%
# 重命名列
rename_with(~ paste0(., "_coevolved_ASV"))
rlang::last_trace()
