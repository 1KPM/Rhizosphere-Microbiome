library(dplyr)
library(tibble)
library(ggtree)
library(ggplot2)
library(ggtreeExtra)
library(RColorBrewer)
library(ggnewscale)
library(reshape2)
library(scales)
library(Rmisc)
library(tidyr)
library(ape)
### 绘制ASV水平的系统发育树+barplot图
### 设置工作目录
pwd <- dirname(rstudioapi::getSourceEditorContext()$path)
setwd(pwd)
###########################################################################################
###细菌
plant_colors <- read.csv("./data/Tree_top10Order_color.csv")
bac_lambda_rf_asv <- read.csv(file = "./data/bac_core_asv_log_lambda_indicators.csv", row.names = 1)
######################################################################
######################################################################
library(dplyr)
library(tibble)
library(ggtree)
library(ggplot2)
library(ggtreeExtra)
library(RColorBrewer)
library(ggnewscale)
library(reshape2)
library(scales)
library(Rmisc)
library(tidyr)
library(ape)
### 绘制ASV水平的系统发育树+barplot图
### 设置工作目录
pwd <- dirname(rstudioapi::getSourceEditorContext()$path)
setwd(pwd)
###########################################################################################
###细菌
plant_colors <- read.csv("./data/Tree_top10Order_color.csv")
bac_lambda_rf_asv <- read.csv(file = "./data/bac_core_asv_qa_log_lambda_indicators.csv", row.names = 1)
subset(bac_lambda_rf_asv, Tree_Order == "Fabales")$Order
table(!is.na(bac_lambda_rf_asv$Tree_Order) & bac_lambda_rf_asv$FDR < 0.05)
table(subset(bac_lambda_rf_asv, !is.na(Tree_Order) & FDR < 0.05)$Tree_Order)
###
bac_asv_mean <- read.csv('./data/bac_core_feature_table_relative_mean.csv', header = T, row.names = 1, check.names=F)
####注意，直接读取会把数字开头的列名前面加"X"，需要设置check.names=F
bac_asv_mean <- as.data.frame(t(bac_asv_mean)) %>%
rownames_to_column("FeatureID")
### abundance
### 在以上的基础上，选择coevolved asv绘制植物水平的系统发育树；取其总丰度呈现
bac_order_coevoled_asv <- bac_lambda_rf_asv[!is.na(bac_lambda_rf_asv$Tree_Order) & bac_lambda_rf_asv$P < 0.05,]
bac_order_coevoled_asv <- merge.data.frame(bac_order_coevoled_asv[,c("FeatureID", "Tree_Order")], bac_asv_mean, by = "FeatureID")
bac_order_coevoled_asv_total <- aggregate(bac_order_coevoled_asv[,-c(1:2)], by = list(bac_order_coevoled_asv$Tree_Order), FUN = sum)
bac_order_coevoled_asv_total <- bac_order_coevoled_asv_total %>% column_to_rownames("Group.1")
bac_order_coevoled_asv_total <- as.data.frame(t(bac_order_coevoled_asv_total))
bac_order_coevoled_asv_total <- bac_order_coevoled_asv_total[, plant_colors$Order]
names(bac_order_coevoled_asv_total) <- paste(names(bac_order_coevoled_asv_total), "_coevolved_ASV", sep = "")
###tree
tree_file <- read.tree('./data/tree_metadata_merge_info_final_align_tree.nwk')
drop_list <- tree_file$tip.label[-match(row.names(bac_order_coevoled_asv_total), tree_file$tip.label)]
fin_tree <- drop.tip(tree_file, drop_list)
fin_table <- bac_order_coevoled_asv_total[row.names(bac_order_coevoled_asv_total) %in% fin_tree$tip.label,]
###
metadata_tree <- read.csv('./data/tree_metadata_merge_info.csv')
metadata_tree <- subset(metadata_tree, metadata_tree$TreeID %in% fin_tree$tip.label)
metadata_tree$Order <- ifelse(metadata_tree$Order %in% plant_colors$Order, metadata_tree$Order, "Others")
table(metadata_tree$Order)
metadata_tree$Order <- factor(metadata_tree$Order, levels = plant_colors$Order)
fin_table <- fin_table[fin_tree$tip.label, ] ###重新排序与tip.label一致
fin_table <- fin_table %>% rownames_to_column("label")  ###ggtree的名称是label, 不能改为其它的
###
plant_groupInfo <- split(
metadata_tree$TreeID,
metadata_tree$Order  # 使用Order作为分组依据
)
# 使用groupOTU整合分组信息
plant_tree_grouped <- groupOTU(
fin_tree,
plant_groupInfo,
group_name = "Lineage"  # 自定义分组变量名
)
### 完整可视化流程 ----------------------------------------------------------
plant_tree <- ggtree(plant_tree_grouped, aes(color=Lineage), size = 1, ladderize = T, linewidth = 0.1,
layout = 'fan', branch.length = "none", right = TRUE, open.angle = 180) +
scale_color_manual(values = plant_colors$Color2, breaks = plant_colors$Order) +
new_scale_color()
plant_tree
# 定义需要绘制的列名
coevoled_asv_columns <- names(fin_table)[-1]
# 创建命名颜色向量（确保顺序匹配）
color_vector <- setNames(plant_colors$Color2, coevoled_asv_columns)
###
plant_final_plot <- plant_tree
for (col in coevoled_asv_columns) {
# 为当前列获取对应的颜色
col_color <- color_vector[col]
plant_final_plot <- plant_final_plot +
geom_fruit(
data = fin_table,
geom = geom_bar,
stat = 'identity',
width = 2,
aes_string(y = "label", x = col),  # 使用 aes_string 简化语法
pwidth = 0.1,
fill = col_color
)
}
plant_final_plot
# 保存结果
ggsave(plant_final_plot,
filename = "./result/Figure5D_plant_orders_coevolved_bacterial_asv.pdf",
width = 12, height = 12,  dpi = 900, bg = "white")
###
final_plot <- plant_final_plot + theme(legend.position = "none")
ggsave(final_plot,
filename = "./result/Figure5D_plant_orders_coevolved_bacterial_asv_nolegend.pdf",
width = 115/2, height = 115/2, units = "mm", dpi = 900, bg = "white")
ggsave(final_plot,
filename = "./result/Figure5D_plant_orders_coevolved_bacterial_asv_nolegend.tiff",
width = 115/2, height = 115/2, units = "mm", dpi = 900, bg = "white")
ggsave(final_plot,
filename = "./result/Figure5D_plant_orders_coevolved_bacterial_asv_nolegend.jpg",
width = 115/2, height = 115/2, units = "mm", dpi = 900, bg = "white")
# 加载必要的包
library(dplyr)
library(tibble)
library(ggtree)
library(ggplot2)
library(ggtreeExtra)
library(RColorBrewer)
library(ggnewscale)
library(reshape2)
library(scales)
library(tidyr)
library(ape)
# 设置工作目录（使用RStudio API）
if (interactive()) {
pwd <- dirname(rstudioapi::getSourceEditorContext()$path)
setwd(pwd)
}
# 1. 数据准备 ---------------------------------------------------------------
# 加载植物分类颜色映射
plant_colors <- read.csv("./data/Tree_top10Order_color.csv")
pro_lambda_rf_asv <- read.csv(file = "./data/pro_core_asv_qa_log_lambda_indicators.csv", row.names = 1)
subset(pro_lambda_rf_asv, Tree_Order == "Fabales")$Order
table(!is.na(pro_lambda_rf_asv$Tree_Order) & pro_lambda_rf_asv$FDR < 0.05)
table(subset(pro_lambda_rf_asv, !is.na(Tree_Order) & FDR < 0.05)$Tree_Order)
###
pro_asv_mean <- read.csv('./data/pro_core_feature_table_relative_mean.csv', header = T, row.names = 1, check.names=F)
####注意，直接读取会把数字开头的列名前面加"X"，需要设置check.names=F
pro_asv_mean <- as.data.frame(t(pro_asv_mean)) %>%
rownames_to_column("FeatureID")
### abundance
### 在以上的基础上，选择coevolved asv绘制植物水平的系统发育树；取其总丰度呈现
pro_order_coevoled_asv <- pro_lambda_rf_asv[!is.na(pro_lambda_rf_asv$Tree_Order) & pro_lambda_rf_asv$P < 0.05,]
pro_order_coevoled_asv <- merge.data.frame(pro_order_coevoled_asv[,c("FeatureID", "Tree_Order")], pro_asv_mean, by = "FeatureID")
pro_order_coevoled_asv_total <- aggregate(pro_order_coevoled_asv[,-c(1:2)], by = list(pro_order_coevoled_asv$Tree_Order), FUN = sum)
pro_order_coevoled_asv_total <- pro_order_coevoled_asv_total %>% column_to_rownames("Group.1")
pro_order_coevoled_asv_total <- as.data.frame(t(pro_order_coevoled_asv_total))
pro_order_coevoled_asv_total <- pro_order_coevoled_asv_total[, plant_colors$Order]
names(pro_order_coevoled_asv_total) <- paste(names(pro_order_coevoled_asv_total), "_coevolved_ASV", sep = "")
###tree
tree_file <- read.tree('./data/tree_metadata_merge_info_final_align_tree.nwk')
drop_list <- tree_file$tip.label[-match(row.names(pro_order_coevoled_asv_total), tree_file$tip.label)]
fin_tree <- drop.tip(tree_file, drop_list)
fin_table <- pro_order_coevoled_asv_total[row.names(pro_order_coevoled_asv_total) %in% fin_tree$tip.label,]
###
metadata_tree <- read.csv('./data/tree_metadata_merge_info.csv')
metadata_tree <- subset(metadata_tree, metadata_tree$TreeID %in% fin_tree$tip.label)
metadata_tree$Order <- ifelse(metadata_tree$Order %in% plant_colors$Order, metadata_tree$Order, "Others")
table(metadata_tree$Order)
metadata_tree$Order <- factor(metadata_tree$Order, levels = plant_colors$Order)
fin_table <- fin_table[fin_tree$tip.label, ] ###重新排序与tip.label一致
fin_table <- fin_table %>% rownames_to_column("label")  ###ggtree的名称是label, 不能改为其它的
###
plant_groupInfo <- split(
metadata_tree$TreeID,
metadata_tree$Order  # 使用Order作为分组依据
)
# 使用groupOTU整合分组信息
plant_tree_grouped <- groupOTU(
fin_tree,
plant_groupInfo,
group_name = "Lineage"  # 自定义分组变量名
)
### 完整可视化流程 ----------------------------------------------------------
plant_tree <- ggtree(plant_tree_grouped, aes(color=Lineage), size = 1, ladderize = T, linewidth = 0.1,
layout = 'fan', branch.length = "none", right = TRUE, open.angle = 180) +
scale_color_manual(values = plant_colors$Color2, breaks = plant_colors$Order) +
new_scale_color()
plant_tree
# 定义需要绘制的列名
coevoled_asv_columns <- names(fin_table)[-1]
# 创建命名颜色向量（确保顺序匹配）
color_vector <- setNames(plant_colors$Color2, coevoled_asv_columns)
###
plant_final_plot <- plant_tree
for (col in coevoled_asv_columns) {
# 为当前列获取对应的颜色
col_color <- color_vector[col]
plant_final_plot <- plant_final_plot +
geom_fruit(
data = fin_table,
geom = geom_bar,
stat = 'identity',
width = 2,
aes_string(y = "label", x = col),  # 使用 aes_string 简化语法
pwidth = 0.1,
fill = col_color
)
}
plant_final_plot
# 保存结果
ggsave(plant_final_plot,
filename = "./result/Figure5F_plant_orders_coevolved_protistan_asv.pdf",
width = 12, height = 12,  dpi = 900, bg = "white")
###
final_plot <- plant_final_plot + theme(legend.position = "none")
